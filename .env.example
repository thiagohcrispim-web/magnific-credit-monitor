# Copie para .env e preencha. Nunca comite o .env de verdade.

MOCK=false
PORT=8787
SNAPSHOT_INTERVAL_MINUTES=15

# Lista JSON das contas Magnific monitoradas.
ACCOUNTS=[{"id":"nucleo01","label":"nucleo01 (trabalho)","renewalDay":6}]

# SQLite local em dev (padrão). Em produção, aponte para o Turso:
# DATABASE_URL=libsql://<seu-banco>.turso.io
# DATABASE_AUTH_TOKEN=<token do turso>
DATABASE_URL=file:./data/dev.db

# Preenchidos depois de rodar `npm run login:magnific -- <accountId>`.
MAGNIFIC_OAUTH_CLIENT_ID=
MAGNIFIC_REFRESH_TOKEN_NUCLEO01=
